# Configure custom error pages for Hostinger (Apache/LiteSpeed)
ErrorDocument 404 /404.html
ErrorDocument 500 /error.html
ErrorDocument 403 /404.html

RewriteEngine On

# Redirect explicitly typed .html requests to extensionless URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP
RewriteRule ^([^.]+)\.html$ / [R=301,L]

# Internally rewrite extensionless URLs to .html files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ .html [L,QSA]
